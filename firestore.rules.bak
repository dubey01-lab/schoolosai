rules_version = '2';
service cloud.firestore {
  match /databases/{database
    // --- ENQUIRIES ---
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
  }
/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().get('role', '') == role;
    }

    function isSuperAdmin() {
      return hasRole("SUPER_ADMIN");
    }

    function isAdmin() {
      return hasRole("ADMIN");
    }

    function isTeacher() {
      return hasRole("TEACHER");
    }

    function isParent() {
      return hasRole("PARENT");
    }

    function getUserSchoolId() {
      return getUserData().get('schoolId', null);
    }

    function belongsToSchool(schoolId) {
      return isSignedIn() && getUserSchoolId() == schoolId;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow read: if isSuperAdmin();
      allow read: if isAdmin() && resource.data.get('schoolId', null) == getUserSchoolId();
      
      allow update, delete: if isSuperAdmin();
      allow update, delete: if isAdmin() && request.resource.data.get('schoolId', null) == getUserSchoolId() && request.resource.data.get('role', '') != 'SUPER_ADMIN';
      
      // Allow initial setup: user can create their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSuperAdmin();
      allow create: if isAdmin() && request.resource.data.get('schoolId', null) == getUserSchoolId() && request.resource.data.get('role', '') != 'SUPER_ADMIN';
    }

    // --- SCHOOLS ---
    match /schools/{schoolId} {
      allow read: if isSuperAdmin();
      allow read: if belongsToSchool(schoolId);
      
      allow create, update: if isSuperAdmin();
      allow create, update: if isAdmin() && belongsToSchool(schoolId);
      allow delete: if isSuperAdmin();
    }

    // --- ADMISSIONS ---
    match /admissions/{admissionId} {
      allow read: if isSuperAdmin();
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      
      allow create, update: if isSuperAdmin();
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isSuperAdmin();
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- STUDENTS ---
    match /students/{studentId} {
      allow read: if isSuperAdmin();
      allow read: if (isAdmin() || isTeacher()) && belongsToSchool(resource.data.get('schoolId', null));
      allow read: if isParent() && resource.data.get('parentId', null) == request.auth.uid;
      
      allow create, update: if isSuperAdmin();
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isSuperAdmin();
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- TEACHERS ---
    match /teachers/{teacherId} {
      allow read: if isSuperAdmin();
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      
      allow create, update: if isSuperAdmin();
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isSuperAdmin();
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- ATTENDANCE ---
    match /attendance/{attendanceId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && (isAdmin() || isTeacher());
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && isParent() && get(/databases/$(database)/documents/students/$(resource.data.get('studentId', null))).data.get('parentId', null) == request.auth.uid;
      
      allow create, update: if (isAdmin() || isTeacher()) && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if (isAdmin() || isTeacher()) && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- FEES & FEE STRUCTURES ---
    match /feeStructures/{structureId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    match /fees/{feeId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && isAdmin();
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && isParent() && get(/databases/$(database)/documents/students/$(resource.data.get('studentId', null))).data.get('parentId', null) == request.auth.uid;
      
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    match /feeTransactions/{transactionId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && isAdmin();
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && isParent() && get(/databases/$(database)/documents/students/$(resource.data.get('studentId', null))).data.get('parentId', null) == request.auth.uid;
      
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    match /feeRefunds/{refundId} {
      allow read: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- NOTICES ---
    match /notices/{noticeId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && resource.data.get('userId', null) == request.auth.uid;
      allow create: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow update: if belongsToSchool(resource.data.get('schoolId', null)) && resource.data.get('userId', null) == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    match /notificationPreferences/{preferenceId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && resource.data.get('userId', null) == request.auth.uid;
      allow create, update: if belongsToSchool(request.resource.data.get('schoolId', null)) && request.resource.data.get('userId', null) == request.auth.uid;
      allow delete: if belongsToSchool(resource.data.get('schoolId', null)) && resource.data.get('userId', null) == request.auth.uid;
    }

    // --- HOMEWORK ---
    match /homework/{homeworkId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && (isAdmin() || isTeacher() || isParent());
      allow create, update: if (isAdmin() || isTeacher()) && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if (isAdmin() || isTeacher()) && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- EXAMS & RESULTS ---
    match /exams/{examId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if (isAdmin() || isTeacher()) && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if (isAdmin() || isTeacher()) && belongsToSchool(resource.data.get('schoolId', null));
    }

    match /results/{resultId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && (isAdmin() || isTeacher());
      allow read: if belongsToSchool(resource.data.get('schoolId', null)) && isParent() && get(/databases/$(database)/documents/students/$(resource.data.get('studentId', null))).data.get('parentId', null) == request.auth.uid;
      
      allow create, update: if (isAdmin() || isTeacher()) && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if (isAdmin() || isTeacher()) && belongsToSchool(resource.data.get('schoolId', null));
    }

    
    // --- CLASSES, SECTIONS, SUBJECTS ---
    match /classes/{classId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }
    match /sections/{sectionId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }
    match /subjects/{subjectId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if isAdmin() && belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if isAdmin() && belongsToSchool(resource.data.get('schoolId', null));
    }

    // --- COMPLAINTS ---
    match /complaints/{complaintId} {
      allow read: if belongsToSchool(resource.data.get('schoolId', null));
      allow create, update: if belongsToSchool(request.resource.data.get('schoolId', null));
      allow delete: if belongsToSchool(resource.data.get('schoolId', null));
    }
  }
    // --- ENQUIRIES ---
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
  }
}
